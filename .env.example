# Optional overrides. Copy to .env if you need any of them; defaults work as is.

# Host port for the Docker Postgres (bound to 127.0.0.1 only).
# POSTGRES_PORT=54329
# DATABASE_URL=postgres://factory@127.0.0.1:54329/factory

# Where run folders and git worktrees live.
# FACTORY_HOME=~/.software-factory

# API + UI port (the built UI is served from here by `pnpm start`).
# PORT=4317

# Absolute path to the claude CLI (default: found on PATH / ~/.local/bin).
# CLAUDE_BIN=/Users/you/.local/bin/claude
